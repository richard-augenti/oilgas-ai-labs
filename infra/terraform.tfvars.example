# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
#
#   cp terraform.tfvars.example terraform.tfvars

# One notebook instance per learner. Set this deliberately — the default is 2,
# which is a dry run, not a classroom.
learner_count = 20

instance_type = "ml.t3.medium" # $0.0500/hr in us-east-1
volume_size   = 5              # GB; minimum, and ample for CSV-scale labs
region        = "us-east-1"
name_prefix   = "oilgas-lab"

# Optional: pre-stage the lab dataset onto every instance at launch so learners
# are not all downloading it over conference wifi simultaneously.
#
# Lab 1 candidate (Utah FORGE Well 58-32, CC BY 4.0, 1.24 MB, 7,310 rows) —
# verified live on 2026-10-04, but the lab's dataset selection is not yet final:
#
# dataset_url = "https://gdr.openei.org/files/1113/Well_58-32_processed_pason_log.csv"

# Learners get a managed workstation, not root, by default.
root_access = "Disabled"
