# ---- Secrets: never commit ----
.env
.env.*
!.env.example
terraform_accessKeys.csv
*accessKeys*.csv
credentials
*.pem
*.key

# ---- Infrastructure: kept local, not published ----
# The training environment is provisioned from a local working copy of infra/.
# This repo stays focused on the labs themselves.
infra/

# ---- Terraform ----
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# ---- Large / derived lab data ----
# Learner datasets are downloaded from their original source, not vendored here.
# See each lab's README for the download link and license.
*.zip
*.parquet
*.las

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# ---- Office lock files ----
~$*.xlsx
~$*.docx
~$*.pptx
