# ---- Secrets: never commit ----
.env
.env.*
!.env.example
terraform_accessKeys.csv
*accessKeys*.csv
credentials
*.pem
*.key

# ---- Terraform ----
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
# .terraform.lock.hcl is intentionally NOT ignored — it pins provider versions
# so every delivery of this training provisions an identical environment.

# ---- Large / derived lab data ----
# Learner datasets are downloaded from their original source, not vendored here.
# See each lab's README for the download link and license.
*.zip
*.parquet
*.las

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# ---- Office lock files ----
~$*.xlsx
~$*.docx
~$*.pptx
